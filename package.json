{
  "name": "electron-chat-app",
  "version": "1.0.0",
  "description": "A secure, production-ready Electron chat application with real-time messaging",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/server/server.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:all": "electron-builder -mwl",
    "postinstall": "node -e \"const fs = require('fs'); fs.copyFileSync('node_modules/socket.io-client/dist/socket.io.min.js', 'src/renderer/socket.io.min.js')\""
  },
  "keywords": [
    "electron",
    "chat",
    "socket.io",
    "mysql",
    "messaging"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.2",
    "socket.io-client": "^4.6.2",
    "mysql2": "^3.6.1",
    "bcrypt": "^5.1.1",
    "express-session": "^1.17.3",
    "express-rate-limit": "^7.1.5",
    "csurf": "^1.11.0",
    "cookie-parser": "^1.4.6"
  },
  "build": {
    "appId": "com.electron.chatapp",
    "productName": "Electron Chat App",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  }
}
